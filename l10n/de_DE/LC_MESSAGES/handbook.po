# German translation of the handbook extension.
#
# Sources: E::ts() literals in PHP and {ts domain="handbook"} blocks in
# templates/. CiviCRM reads only the .mo: recompile it after every edit with
# `msgfmt --check --statistics -o handbook.mo handbook.po`. Keep each msgid
# and msgstr on one line: the tests read the file that way.
msgid ""
msgstr ""
"Project-Id-Version: handbook\n"
"PO-Revision-Date: 2026-10-13\n"
"Last-Translator: \n"
"Language-Team: German\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: de\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: Civi/Handbook/ContextHelp.php
msgid "Handbook: read manuals"
msgstr "Handbuch: Anleitungen lesen"

#: Civi/Handbook/ContextHelp.php
msgid "Open and search the handbook of user manuals."
msgstr "Das Handbuch mit den Bedienungsanleitungen öffnen und durchsuchen."

#: Civi/Handbook/ContextHelp.php
msgid "Handbook: %1"
msgstr "Handbuch: %1"

#: Civi/Handbook/ContextHelp.php
msgid "Manuals for this page"
msgstr "Anleitungen zu dieser Seite"

#: Civi/Handbook/Dependencies.php
msgid "The handbook libraries are missing (vendor/). Run “composer install --no-dev” in the extension directory."
msgstr "Die Programmbibliotheken des Handbuchs fehlen (vendor/). Bitte im Verzeichnis der Erweiterung „composer install --no-dev“ ausführen."

#: Civi/Handbook/ExtraDir.php
msgid "The extra handbook directory must be an absolute path (starting with /), not “%1”."
msgstr "Das zusätzliche Handbuch-Verzeichnis muss ein absoluter Pfad sein (beginnt mit /), nicht „%1“."

#: Civi/Handbook/Frontmatter.php
msgid "%1: frontmatter is not valid YAML (%2)."
msgstr "%1: Frontmatter ist kein gültiges YAML (%2)."

#: Civi/Handbook/Frontmatter.php
msgid "%1: frontmatter is not a map of keys to values."
msgstr "%1: Frontmatter ist keine Zuordnung von Schlüsseln zu Werten."

#: Civi/Handbook/Library.php Civi/Handbook/PageLoader.php
msgid "%1: invalid file name."
msgstr "%1: ungültiger Dateiname."

#: Civi/Handbook/Library.php
msgid "%1: translation without the default page %2."
msgstr "%1: Übersetzung ohne die Standardseite %2."

#: Civi/Handbook/PageLoader.php
msgid "%1: title and section must be text, order a whole number and routes a list of paths."
msgstr "%1: title und section müssen Text, order eine ganze Zahl und routes eine Liste von Pfaden sein."

#: Civi/Handbook/Sources.php
msgid "The extra handbook directory is not read: an extension is already named “%1”."
msgstr "Das zusätzliche Handbuch-Verzeichnis wird nicht gelesen: eine Erweiterung heißt bereits „%1“."

#: Civi/Handbook/Sources.php
msgid "The extra handbook directory “%1” is not a readable directory."
msgstr "Das zusätzliche Handbuch-Verzeichnis „%1“ ist kein lesbares Verzeichnis."

#: Civi/Handbook/Sources.php
msgid "More manuals"
